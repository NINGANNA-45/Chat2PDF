PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Max time (ms) allowed to fetch a remote chat page
FETCH_TIMEOUT_MS=15000
# Max characters of a message to accept (guards against runaway pages)
MAX_MESSAGE_LENGTH=200000
# Max bytes to download from any single remote page (response-size guard)
MAX_RESPONSE_BYTES=8388608
# When "true", failed /api/fetch-chat responses include a non-sensitive
# `diagnostics` object (fetch status, content type, detected payload type,
# parse stage) to help debug extraction issues. Never enable in a public
# production deployment you don't control - keep it for local debugging.
DEBUG_CHAT2PDF=false
